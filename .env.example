# ============================================
# NqobileQ Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!
# ============================================

# Database Configuration
# For Docker: DB_HOST=db
# For WAMP/local: DB_HOST=localhost
DB_HOST=db
DB_USER=nqobileq_user
DB_PASSWORD=CHANGE_ME
DB_NAME=nqobileq_db
DB_ROOT_PASSWORD=CHANGE_ME

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SECURE=tls

# Site Configuration
# Leave empty for auto-detection, or set your domain/IP
SITE_URL=
APP_ENV=production

# Contact Info
OWNER_PHONE=+27782280408
OWNER_EMAIL=your-email@gmail.com

# Stripe Configuration (Test Keys - Get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY